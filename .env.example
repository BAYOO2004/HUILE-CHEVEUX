# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# SUPABASE_URL: Your Supabase Project URL (Optional, fallback to local storage if missing)
SUPABASE_URL="https://your-project-id.supabase.co"

# SUPABASE_ANON_KEY: Your Supabase Anon Public Key (Optional, fallback to local storage if missing)
SUPABASE_ANON_KEY="your-anon-public-key"

# ADMIN_PASSWORD: Required to access the admin dashboard space
ADMIN_PASSWORD="golden_admin_2026"

# VITE_WHATSAPP_NUMBER: The WhatsApp hotline number for orders in Benin (e.g., 22990000000)
VITE_WHATSAPP_NUMBER="22990000000"

